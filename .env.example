# Copy to .env and adjust. Every value here is optional; the defaults work.

# ---- Core -------------------------------------------------------------------
TZ=Europe/Berlin
BASE_URL=http://localhost:8080
# Leave empty to generate a persistent key into DATA_DIR on first start.
SECRET_KEY=
DATA_DIR=/data
LOG_LEVEL=INFO

# ---- Database ---------------------------------------------------------------
# Empty means SQLite inside DATA_DIR.
# DATABASE_URL=postgresql+psycopg://amisearch:amisearch@db:5432/amisearch

# ---- Accounts ---------------------------------------------------------------
ALLOW_REGISTRATION=true
ACCESS_TOKEN_TTL_MINUTES=20160

# ---- Polling ----------------------------------------------------------------
SCHEDULER_ENABLED=true
WORKER_CONCURRENCY=4
MIN_POLL_INTERVAL_SECONDS=15
DEFAULT_POLL_INTERVAL_SECONDS=300
ADAPTIVE_POLLING=true

# ---- Upstream shops ---------------------------------------------------------
PROVIDER_REQUESTS_PER_MINUTE=40
PROVIDER_MAX_CONCURRENCY=3
PROVIDER_TIMEOUT_SECONDS=20

# ---- Catalogue ingest --------------------------------------------------------
# Builds the local catalogue in the background so discovery has a corpus.
CRAWLER_ENABLED=true
CRAWLER_REQUESTS_PER_MINUTE=8
CRAWLER_MAX_SECONDS_PER_RUN=240
CRAWLER_RUN_INTERVAL_MINUTES=5
# Overnight the pace is deliberately eased off.
CRAWLER_QUIET_HOURS_START=1
CRAWLER_QUIET_HOURS_END=7

# ---- MyFigureCollection ------------------------------------------------------
MFC_ENABLED=true
MFC_REQUESTS_PER_MINUTE=10
MFC_BATCH_SIZE=8
# Optional. A PHPSESSID from a signed-in browser, which makes entries that MFC
# withholds from guests readable. Never your password. Can also be set from
# Administration without a restart.
MFC_SESSION_COOKIE=

# ---- Currency ---------------------------------------------------------------
DISPLAY_CURRENCY=EUR
FX_REFRESH_HOURS=6

# ---- Web Push ---------------------------------------------------------------
# Generate from Administration inside the app, then paste and restart.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- SMTP -------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

# ---- Retention --------------------------------------------------------------
PRICE_HISTORY_RETENTION_DAYS=1095
ALERT_RETENTION_DAYS=365
