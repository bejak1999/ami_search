# Copy to .env and adjust. Every value here is optional; the defaults work.

# ---- Core -------------------------------------------------------------------
TZ=Europe/Berlin
BASE_URL=http://localhost:8080
# Leave empty to generate a persistent key into DATA_DIR on first start.
SECRET_KEY=
DATA_DIR=/data
LOG_LEVEL=INFO

# ---- Database ---------------------------------------------------------------
# Empty means SQLite inside DATA_DIR.
# DATABASE_URL=postgresql+psycopg://amisearch:amisearch@db:5432/amisearch

# ---- Accounts ---------------------------------------------------------------
ALLOW_REGISTRATION=true
ACCESS_TOKEN_TTL_MINUTES=20160

# ---- Polling ----------------------------------------------------------------
SCHEDULER_ENABLED=true
WORKER_CONCURRENCY=4
MIN_POLL_INTERVAL_SECONDS=15
DEFAULT_POLL_INTERVAL_SECONDS=300
ADAPTIVE_POLLING=true

# ---- Upstream shops ---------------------------------------------------------
PROVIDER_REQUESTS_PER_MINUTE=40
PROVIDER_MAX_CONCURRENCY=3
PROVIDER_TIMEOUT_SECONDS=20

# ---- Catalogue ingest --------------------------------------------------------
# Builds the local catalogue in the background so discovery has a corpus.
CRAWLER_ENABLED=true
CRAWLER_REQUESTS_PER_MINUTE=8
CRAWLER_MAX_SECONDS_PER_RUN=240
CRAWLER_RUN_INTERVAL_MINUTES=5
# Overnight the pace is deliberately eased off.
CRAWLER_QUIET_HOURS_START=1
CRAWLER_QUIET_HOURS_END=7

# ---- Backups -----------------------------------------------------------------
# There is nothing to configure: backups are taken on demand from the
# Administration page and downloaded to your machine. Two things are worth
# knowing. Archives contain notification credentials in plain text unless you
# untick that box, so treat them like a password file. And SECRET_KEY signs
# session cookies rather than encrypting data, so restoring onto a host with a
# different key simply means everyone signs in again - nothing is lost.

# ---- Shelf life --------------------------------------------------------------
# Follows individual pre-owned copies so a listing that vanishes is recorded as
# a sale, which is what makes "copies of this figure sell in about 5 days"
# something we can actually show. Turning this off still leaves the cheaper
# estimate that rides along on detail fetches happening for other reasons.
SHELF_TRACKING_ENABLED=true
SHELF_REQUESTS_PER_MINUTE=10
SHELF_MAX_SECONDS_PER_RUN=240
SHELF_RUN_INTERVAL_MINUTES=10
# How often each tier is looked at, in hours. Hot is the handful of products
# someone is waiting on, where a tight answer is worth the requests; cold is
# the long tail, which only has to feed the statistics.
SHELF_HOT_INTERVAL_HOURS=2
SHELF_WARM_INTERVAL_HOURS=12
SHELF_COLD_INTERVAL_HOURS=72

# ---- MyFigureCollection ------------------------------------------------------
MFC_ENABLED=true
MFC_REQUESTS_PER_MINUTE=10
# 0 works the batch size out from the rate above, which is almost always
# what you want: a fixed number silently caps the backlog far below the
# budget you configured. Set a number only to override that.
MFC_BATCH_SIZE=0
# Optional. A PHPSESSID from a signed-in browser, which makes entries that MFC
# withholds from guests readable. Never your password. Can also be set from
# Administration without a restart.
MFC_SESSION_COOKIE=

# ---- Currency ---------------------------------------------------------------
DISPLAY_CURRENCY=EUR
FX_REFRESH_HOURS=6

# ---- Web Push ---------------------------------------------------------------
# Generate from Administration inside the app, then paste and restart.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- SMTP -------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

# ---- Image cache -------------------------------------------------------------
# AmiAmi deletes a pre-owned listing's photos when it sells, so a local copy is
# what keeps the record from becoming a row with a broken frame.
IMAGE_CACHE_ENABLED=true
IMAGE_CACHE_MAX_GB=12
# false keeps only the 4 KB thumbnails, cutting the whole catalogue to ~0.2 GB
IMAGE_CACHE_FULL_IMAGES=true

# ---- Retention --------------------------------------------------------------
PRICE_HISTORY_RETENTION_DAYS=1095
ALERT_RETENTION_DAYS=365
